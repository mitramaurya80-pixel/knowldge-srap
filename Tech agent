#!/usr/bin/env python3
"""
Tech / Startup / Discovery Aggregator Agent
--------------------------------------------
Collects the latest technology news, startup announcements, and scientific
discoveries from free, publicly available APIs and RSS feeds.

No raw HTML scraping is used — everything here goes through official APIs
or public RSS feeds, which is faster, more reliable, and doesn't risk
violating a site's Terms of Service.

Usage:
    python tech_agent.py                  # fetch everything, print summary
    python tech_agent.py --save out.json  # also save full results to JSON
    python tech_agent.py --category hn    # only one category
                                           # (hn, arxiv, rss, github)
"""

import argparse
import json
import time
from datetime import datetime, timezone

import requests
import feedparser

# ----------------------------------------------------------------------
# CONFIG
# ----------------------------------------------------------------------

HEADERS = {"User-Agent": "TechAggregatorAgent/1.0 (educational/personal use)"}

RSS_FEEDS = {
    "TechCrunch": "https://techcrunch.com/feed/",
    "The Verge": "https://www.theverge.com/rss/index.xml",
    "Product Hunt": "https://www.producthunt.com/feed",
    "MIT Technology Review": "https://www.technologyreview.com/feed/",
    "Wired": "https://www.wired.com/feed/rss",
}

ARXIV_CATEGORIES = {
    "AI": "cs.AI",
    "Machine Learning": "cs.LG",
    "Robotics": "cs.RO",
}

REQUEST_TIMEOUT = 10
ITEMS_PER_SOURCE = 8


# ----------------------------------------------------------------------
# COLLECTORS
# ----------------------------------------------------------------------

def get_hacker_news(limit=ITEMS_PER_SOURCE):
    """Top stories from Hacker News (free, no key required)."""
    results = []
    try:
        top_ids = requests.get(
            "https://hacker-news.firebaseio.com/v0/topstories.json",
            timeout=REQUEST_TIMEOUT,
        ).json()[:limit]

        for story_id in top_ids:
            item = requests.get(
                f"https://hacker-news.firebaseio.com/v0/item/{story_id}.json",
                timeout=REQUEST_TIMEOUT,
            ).json()
            if not item:
                continue
            results.append({
                "title": item.get("title"),
                "url": item.get("url", f"https://news.ycombinator.com/item?id={story_id}"),
                "score": item.get("score"),
                "comments": item.get("descendants", 0),
                "source": "Hacker News",
            })
    except requests.RequestException as e:
        print(f"[!] Hacker News fetch failed: {e}")
    return results


def get_arxiv(limit=5):
    """Recent papers from arXiv (free, no key required)."""
    results = []
    for label, category in ARXIV_CATEGORIES.items():
        try:
            url = (
                "http://export.arxiv.org/api/query?"
                f"search_query=cat:{category}&sortBy=submittedDate&sortOrder=descending"
                f"&max_results={limit}"
            )
            feed = feedparser.parse(url)
            for entry in feed.entries:
                results.append({
                    "title": entry.title.replace("\n", " ").strip(),
                    "url": entry.link,
                    "published": entry.get("published", ""),
                    "category": label,
                    "source": "arXiv",
                })
        except Exception as e:
            print(f"[!] arXiv fetch failed for {label}: {e}")
    return results


def get_rss_feeds(limit=ITEMS_PER_SOURCE):
    """Latest posts from tech/startup RSS feeds (free, no key required)."""
    results = []
    for name, url in RSS_FEEDS.items():
        try:
            feed = feedparser.parse(url)
            for entry in feed.entries[:limit]:
                results.append({
                    "title": entry.get("title", "").strip(),
                    "url": entry.get("link", ""),
                    "published": entry.get("published", entry.get("updated", "")),
                    "source": name,
                })
        except Exception as e:
            print(f"[!] RSS fetch failed for {name}: {e}")
    return results


def get_github_trending(limit=ITEMS_PER_SOURCE):
    """
    New/trending repos via GitHub's public search API (free, no key needed
    for low-volume use; add a token for higher rate limits).
    """
    results = []
    try:
        since = datetime.now(timezone.utc).strftime("%Y-%m-%d")
        # repos created in the last week, sorted by stars
        query = "created:>2024-01-01 stars:>50"
        resp = requests.get(
            "https://api.github.com/search/repositories",
            params={"q": query, "sort": "stars", "order": "desc", "per_page": limit},
            headers=HEADERS,
            timeout=REQUEST_TIMEOUT,
        )
        data = resp.json()
        for repo in data.get("items", [])[:limit]:
            results.append({
                "title": repo["full_name"],
                "url": repo["html_url"],
                "description": repo.get("description"),
                "stars": repo.get("stargazers_count"),
                "source": "GitHub",
            })
    except requests.RequestException as e:
        print(f"[!] GitHub fetch failed: {e}")
    return results


# ----------------------------------------------------------------------
# ORCHESTRATION
# ----------------------------------------------------------------------

COLLECTORS = {
    "hn": ("Hacker News", get_hacker_news),
    "arxiv": ("arXiv Discoveries", get_arxiv),
    "rss": ("Tech & Startup News (RSS)", get_rss_feeds),
    "github": ("GitHub Trending", get_github_trending),
}


def run(categories=None):
    categories = categories or list(COLLECTORS.keys())
    all_results = {}

    for key in categories:
        label, fn = COLLECTORS[key]
        print(f"Fetching: {label} ...")
        all_results[key] = {
            "label": label,
            "items": fn(),
            "fetched_at": datetime.now(timezone.utc).isoformat(),
        }
        time.sleep(0.5)  # be polite between calls

    return all_results


def print_summary(results):
    for key, block in results.items():
        print(f"\n{'='*60}\n{block['label']} ({len(block['items'])} items)\n{'='*60}")
        for item in block["items"]:
            title = item.get("title", "Untitled")
            url = item.get("url", "")
            print(f"- {title}\n  {url}")


# ----------------------------------------------------------------------
# CLI
# ----------------------------------------------------------------------

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Tech/Startup/Discovery Aggregator")
    parser.add_argument("--category", choices=list(COLLECTORS.keys()),
                         help="Only fetch one category")
    parser.add_argument("--save", help="Path to save full JSON results")
    args = parser.parse_args()

    cats = [args.category] if args.category else None
    results = run(cats)
    print_summary(results)

    if args.save:
        with open(args.save, "w") as f:
            json.dump(results, f, indent=2)
        print(f"\nSaved full results to {args.save}")
